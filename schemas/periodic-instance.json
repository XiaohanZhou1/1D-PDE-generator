{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B2 numerical periodic roll specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed", "instance_id", "specification_hash", "family_id",
    "structure_id", "template_version", "parameters", "equations", "target_wave", "eigenproblem",
    "stability_question", "neutral_mode_policy", "calibration", "validity_checks",
    "novelty_assessment", "references"],
  "properties": {
    "schema_version": {"const": "periodic-0.1"},
    "seed": {"type": "integer"},
    "instance_id": {"type": "string", "pattern": "^B2-[a-f0-9]{20}$"},
    "specification_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "family_id": {"const": "B2"},
    "structure_id": {"const": "B2.swift-hohenberg"},
    "template_version": {"const": "1"},
    "parameters": {"type": "object", "additionalProperties": false,
      "required": ["q", "first_cosine_amplitude"],
      "properties": {
        "q": {"$ref": "#/$defs/positiveRational"},
        "first_cosine_amplitude": {"$ref": "#/$defs/positiveRational"}
      }},
    "equations": {"type": "object", "required": ["form", "variables", "r"]},
    "target_wave": {"type": "object", "required": ["form", "speed", "period", "phase", "symmetry", "branch"]},
    "eigenproblem": {"type": "object", "required": ["form", "potential", "function_space",
      "operator_domain", "bloch_domain", "bloch_wavenumber", "fiber"]},
    "stability_question": {"type": "string"},
    "neutral_mode_policy": {"type": "string"},
    "calibration": {"const": true},
    "validity_checks": {"type": "object", "required": ["profile", "period", "phase",
      "linearisation", "phase_mode", "solver_dispatch", "proof_difficulty"],
      "additionalProperties": {"enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_APPLICABLE"]}},
    "novelty_assessment": {"type": "object", "required": ["status", "grouping", "training_admission"]},
    "references": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"positiveRational": {"type": "string", "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)?$"}}
}
