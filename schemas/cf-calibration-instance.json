{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C–F reviewed spectral calibration specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed", "instance_id", "specification_hash", "family_id",
    "structure_id", "template_version", "parameters", "equations", "target_wave", "eigenproblem",
    "stability_question", "calibration", "validity_checks", "novelty_assessment", "references"],
  "properties": {
    "schema_version": {"const": "cf-calibration-0.1"},
    "seed": {"type": "integer"},
    "instance_id": {"type": "string", "pattern": "^[CDEF]1-[a-f0-9]{20}$"},
    "specification_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "family_id": {"enum": ["C1", "D1", "E1", "F1"]},
    "structure_id": {"type": "string"},
    "template_version": {"const": "1"},
    "parameters": {"type": "object", "required": ["case"]},
    "equations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target_wave": {"type": "object", "required": ["profile"]},
    "eigenproblem": {"type": "object", "required": ["form"]},
    "stability_question": {"type": "string"},
    "calibration": {"const": true},
    "validity_checks": {"type": "object", "required": ["solver_dispatch", "proof_difficulty"]},
    "novelty_assessment": {"type": "object", "required": ["status", "grouping", "training_admission"]},
    "references": {"type": "array", "items": {"type": "string"}}
  }
}
